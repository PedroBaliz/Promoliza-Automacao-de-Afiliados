# Copie este arquivo para .env e preencha com os seus valores.
# Nunca versione o .env nem compartilhe os valores reais.

# ---- Geral ----
# Porta do servidor HTTP (/ e /health). No Railway é definida automaticamente.
PORT=3000
# Ambiente de execução. O Docker já define production.
NODE_ENV=development

# ---- Mercado Livre ----
# Tag de afiliado. Dois formatos aceitos:
#   matt:<matt_word>:<matt_tool>  -> adiciona matt_word e matt_tool ao link
#   tag simples (ex.: minha_tag)  -> adiciona o parâmetro tag ao link
# Vazio = aviso no log e links publicados SEM afiliação.
# Formato matt inválido impede a aplicação de iniciar.
ML_AFFILIATE_TAG=matt:sua_matt_word:sua_matt_tool

# ---- Telegram: bot que publica no grupo de destino ----
# Token gerado pelo BotFather.
TELEGRAM_BOT_TOKEN=123456789:token_do_seu_bot_aqui
# ID do grupo/canal de destino (o bot precisa poder enviar mensagens nele).
TELEGRAM_CHAT_ID=-1001234567890

# ---- Telegram: conta de usuário que monitora as origens ----
# Credenciais obtidas em https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=seu_api_hash_aqui
# Telefone da conta de monitoramento, com DDI.
TELEGRAM_SOURCE_PHONE=+5511999999999
# Grupos/canais monitorados: @username ou ID numérico, separados por vírgula.
# Não use o nome exibido do grupo.
TELEGRAM_SOURCE_CHATS=@canal_exemplo,-1001234567890
# Sessão serializada da conta. Deixe vazio e rode `npm run dev` localmente
# para gerar; depois cole o valor aqui. Dá acesso total à conta: não compartilhe.
TELEGRAM_SOURCE_SESSION=

# ---- WhatsApp (opcional) ----
# JID do grupo de destino no formato <id>@g.us. Vazio = WhatsApp desabilitado.
WHATSAPP_GROUP_JID=
